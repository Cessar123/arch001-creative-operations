# Copy these names into Render's Environment dashboard. Never commit real values.
NODE_ENV=production
# Render assigns PORT automatically; do not set it unless Render support requests it.

# Required after migrating off Manus-managed services.
DATABASE_URL=
JWT_SECRET=
APP_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
AUTH_PROVIDER=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

# Do not copy BUILT_IN_FORGE_API_KEY, BUILT_IN_FORGE_API_URL,
# OAUTH_SERVER_URL, VITE_APP_ID, OWNER_OPEN_ID, or any Manus token here.
# They are platform-managed values and are not portable to Render.
